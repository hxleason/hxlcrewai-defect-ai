# ============================================
# 数据库（开发用 SQLite，生产换成 MySQL）
# ============================================
DATABASE_URL=sqlite:///./fmea.db

# ============================================
# LLM 配置（OpenAI 兼容接口均可）
# ============================================
OPENAI_API_KEY=        # 替换为你的 DeepSeek / OpenAI 密钥
OPENAI_BASE_URL=https://api.deepseek.com/v1   # 若使用其他中转 API，修改这里
LLM_MODEL_NAME=deepseek-v4-pro           # 使用的模型名
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# ============================================
# 文件路径（保持默认即可）
# ============================================
REGULATIONS_DIR=./app/regulations
VECTOR_STORE_DIR=./vectorstore
STANDARDS_DIR=./app/standards

# ============================================
# 业务默认值
# ============================================
DEFAULT_WALL_THICKNESS=10.0
DEFAULT_DESIGN_TEMP=25.0
DEFAULT_OPERATING_PRESSURE=1.0

# 日志级别
LOG_LEVEL=INFO这是我原来的# ============================================
